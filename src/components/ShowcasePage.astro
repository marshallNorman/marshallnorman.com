---
import Layout from '../layouts/Layout.astro';
import type { ShowcaseItem } from '../lib/showcase-items';

// Shared layout for showcase pages: password form when signed out, list of work
// when signed in. The default slot renders above the list, signed in only
interface Props {
  eyebrow: string;
  items: ShowcaseItem[];
  authed: boolean;
  error?: string;
}

const { eyebrow, items, authed, error } = Astro.props;
---

<Layout>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400&family=Roboto+Serif:ital,opsz,wght@0,8..144,400;1,8..144,400&display=swap" rel="stylesheet" />

  <main class="sc-page">
    <a class="sc-home" href="/"><span aria-hidden="true">←</span> marshallnorman.com</a>
    <div class="sc-col">
      <p class="sc-label">{eyebrow}</p>
      <h1>Selected work</h1>

      {authed ? (
        <>
          <slot />
          <ul class="sc-cards">
            {items.map((item) => (
              <li>
                <a
                  class="sc-card"
                  href={item.href}
                  target={item.newTab ? '_blank' : undefined}
                  rel={item.newTab ? 'noopener' : undefined}
                >
                  <span class="sc-card-type">
                    {item.type}
                    {item.wip && <span class="sc-card-wip">Work in progress</span>}
                  </span>
                  <span class="sc-card-title">{item.title}</span>
                  <span class="sc-card-desc">{item.description}</span>
                  <span class="sc-card-arrow" aria-hidden="true">{item.newTab ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <form class="sc-form" method="post">
          <label for="sc-password">Password</label>
          <div class="sc-form-row">
            <input id="sc-password" name="password" type="password" autocomplete="current-password" required autofocus />
            <button type="submit">Enter</button>
          </div>
          {error && <p class="sc-error" role="alert">{error}</p>}
        </form>
      )}
    </div>
  </main>
</Layout>

<script>
  // Remembers which showcase page (/showcase, /showcase/rippling…) the visitor is
  // on, so the prototypes' "Showcase" button returns here
  // (scripts/showcase-overrides/showcase-chrome.js)
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.sc-page')) return;
    try {
      sessionStorage.setItem('showcase-home', location.pathname);
    } catch {
      // Storage blocked; the button falls back to /showcase
    }
  });
</script>

<style>
  /* Footer (Contact) inherits the body background */
  :global(:root) {
    --page-bg: #f4f2ff;
  }

  /* Lavender fades deeper toward the bottom of the page, behind the form,
     with a grain overlay (tokens in src/styles/global.css) */
  :global(#contact) {
    background-image: var(--noise), var(--lavender-fade);
    background-blend-mode: soft-light, normal;
  }

  .sc-page {
    --accent: #8674ea;
    --line: #dcd5f5;

    min-height: 100vh;
    background: #f4f2ff;
    color: #000;
    font-family: "Roboto Serif", Georgia, serif;
  }

  .sc-col {
    width: min(680px, 100vw - 48px);
    margin-inline: auto;
    padding: clamp(96px, 12vw, 180px) 0 120px;
  }

  .sc-home {
    position: absolute;
    top: 24px;
    left: 24px;
    display: inline-flex;
    gap: 6px;
    color: var(--accent);
    font-family: "Roboto Mono", ui-monospace, monospace;
    font-size: 13px;
    text-decoration: none;
  }

  .sc-home:hover {
    text-decoration: underline;
  }

  .sc-home:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sc-label,
  .sc-card-type,
  .sc-form label {
    font-family: "Roboto Mono", ui-monospace, monospace;
    font-size: 13px;
    color: var(--accent);
  }

  .sc-label {
    margin: 0 0 12px;
  }

  .sc-card-type {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sc-card-wip {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11px;
    color: #000;
    opacity: 0.6;
  }

  h1 {
    margin: 0 0 48px;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.1;
  }

  .sc-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 56px 24px 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .sc-card:hover,
  .sc-card:focus-visible {
    border-color: var(--accent);
  }

  .sc-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sc-card-title {
    font-size: 24px;
    line-height: 1.25;
  }

  .sc-card-desc {
    font-size: 16px;
    line-height: 26px;
    opacity: 0.75;
  }

  .sc-card-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 20px;
    color: var(--accent);
  }

  .sc-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 420px;
  }

  .sc-form-row {
    display: flex;
    gap: 8px;
  }

  .sc-form input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 16px;
  }

  .sc-form input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .sc-form button {
    padding: 12px 20px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-family: "Roboto Mono", ui-monospace, monospace;
    font-size: 14px;
    cursor: pointer;
  }

  .sc-error {
    margin: 4px 0 0;
    font-family: "Roboto Mono", ui-monospace, monospace;
    font-size: 13px;
    color: #c0392b;
  }
</style>
