    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 16px;
  }

  .pc-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pc-crumbs li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pc-crumbs button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--pc-fg-secondary);
    line-height: 1.4;
  }

  .pc-crumbs button:hover {
    text-decoration: underline;
  }

  .pc-crumbs li > span[aria-hidden] {
    color: #808080;
    font-size: 12px;
  }

  .pc-crumb-current {
    font-weight: 510;
    line-height: 1.4;
  }

  /* Inputs */
  .pc-input {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1.5px solid var(--pc-border-subtle);
    border-radius: 8px;
    background: var(--pc-input-bg);
    color: var(--pc-placeholder);
    line-height: 1.2;
  }

  .pc-input input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--pc-fg-secondary) !important;
    line-height: 1.2;
  }

  .pc-input input::placeholder {
    color: var(--pc-placeholder);
  }

  .pc-input input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .pc-input:focus-within {
    border-color: var(--pc-purple);
  }

  .pc-input--help {
    width: 300px;
  }

  /* Admin nav */
  .pc-body {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  .pc-adminnav {
    flex: none;
    width: 232px;
    padding: 0;
    overflow-y: auto;
    border-right: 1px solid var(--pc-border-subtle);
    background: var(--pc-surface-secondary);
  }

  .pc-adminnav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px;
    border: 0;
    background: none;
    line-height: 1.6;
    text-align: left;
  }

  .pc-adminnav-item:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .pc-adminnav-item.is-active {
    font-weight: 700;
  }

  .pc-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.09);
    font-size: 12px;
    font-weight: 590;
    letter-spacing: 0.25px;
    line-height: 18px;
    white-space: nowrap;
  }

  .pc-badge--new {
    border: 1px solid rgba(124, 82, 255, 0.5);
    background: rgba(218, 199, 255, 0.5);
    color: #3a1d95;
  }

  /* Buttons */
  .pc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5.5px;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    font-weight: 510 !important;
    line-height: 1.2;
    white-space: nowrap;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .pc-btn--primary {
    background: var(--pc-purple);
    color: #fff !important;
  }

  .pc-btn--primary:hover:not(:disabled) {
    background: var(--pc-purple-dark);
  }

  .pc-btn--primary:disabled {
    opacity: 0.45;
    cursor: not-allowed !important;
  }

  .pc-btn--muted {
    color: var(--pc-fg-secondary) !important;
  }

  .pc-btn--muted:hover {
    background: rgba(34, 34, 34, 0.08);
  }

  .pc-btn--outlined {
    border-color: var(--pc-purple);
    color: var(--pc-purple) !important;
  }

  .pc-btn--outlined:hover {
    background: rgba(124, 82, 255, 0.08);
  }

  .pc-btn--text {
    color: var(--pc-purple) !important;
  }

  .pc-btn--text:hover {
    background: rgba(124, 82, 255, 0.08);
  }

  .pc-icon-btn {
    display: grid;
    place-items: center;
    padding: 2px;
    border: 0;
    border-radius: 4px;
    background: none;
  }

  .pc-icon-btn:hover {
    background: rgba(34, 34, 34, 0.1);
  }

  .pc-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--pc-fg-tertiary) !important;
    font-size: 12px;
    text-decoration: underline;
  }

  .pc-underline {
    text-decoration: underline;
  }

  /* Working area */
  .pc-work {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  /* Listing */
  .pc-listing {
    height: 100%;
    padding: 24px 24px 32px;
    overflow-y: auto;
  }

  .pc-listing-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .pc-listing-title {
    margin: 0 0 4px;
    font-size: 27px;
    font-weight: 510;
    line-height: 1.2;
  }

  .pc-listing-desc {
    margin: 0;
    color: var(--pc-fg-secondary);
    line-height: 1.6;
  }

  /* The search field and filter chips share one height */
  .pc-filters {
    --pc-control-h: 32px;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
  }

  .pc-input--table-search {
    box-sizing: border-box;
    width: 296px;
    height: var(--pc-control-h);
    padding: 0 10px;
    font-size: 12px;
  }

  .pc-input--table-search input {
    font-size: 12px;
  }

  .pc-chip {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: var(--pc-control-h);
    padding: 0 8px 0 11px;
    border: 1px solid var(--pc-border-subtle);
    border-radius: 6px;
    color: var(--pc-fg-secondary);
    font-size: 12px;
    font-weight: 510;
  }

  .pc-table {
    overflow: hidden;
    border: 1px solid var(--pc-border-subtle);
    border-radius: 16px;
  }

  .pc-row {
    display: grid;
    grid-template-columns: minmax(0, 2.3fr) minmax(0, 0.65fr) minmax(0, 0.85fr) minmax(0, 0.6fr) minmax(0, 0.6fr);
    align-items: center;
    gap: 16px;
    min-height: 54px;
    padding: 4px 16px;
    border-top: 1px solid var(--pc-border-subtle);
  }

  .pc-row--head {
    min-height: 40px;
    border-top: 0;
    font-size: 12px;
    font-weight: 700;
  }

  .pc-row-name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 590;
  }

  .pc-row-type {
    color: var(--pc-fg-secondary);
  }

  .pc-row-created {
    display: flex;
    flex-direction: column;
    color: var(--pc-fg-secondary);
    line-height: 1.2;
  }

  .pc-row-created small {
    margin-top: 2px;
    color: var(--pc-fg-tertiary);
    font-size: 12px;
  }

  .pc-num {
    text-align: right;
  }

  .pc-row--link {
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .pc-row--link:hover {
    background: #f6f6f6;
  }

  .pc-row--link:focus-visible {
    outline-offset: -2px;
  }

  .pc-row.is-flash {
    animation: pc-flash 1.6s ease-out;
  }

  @keyframes pc-flash {
    0%,
    30% {
      background-color: rgba(124, 82, 255, 0.16);
    }
  }

  .pc-pages {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--pc-fg-secondary);
  }

  .pc-page,
  .pc-page-arrow {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    border-radius: 6px;
  }

  .pc-page-arrow {
    color: #aaa;
    font-size: 20px;
  }

  .pc-page.is-current {
    background: var(--pc-purple);
    color: #fff;
  }

  /* Editor */
  .pc-editor {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pc-editor-head {
    flex: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 24px 16px 32px;
    border-bottom: 1px solid #d2d2d2;
  }

  .pc-title-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 32px;
  }

  .pc-title {
    padding: 0;
    border: 0;
    background: none;
    font-size: 27px !important;
    font-weight: 510 !important;
    line-height: 1.2;
    text-align: left;
    cursor: text !important;
  }

  .pc-title-input {
    padding: 0 6px;
    margin-left: -7px;
    border: 1.5px solid var(--pc-purple);
    border-radius: 6px;
    outline: none;
    font-size: 27px !important;
    font-weight: 510;
    line-height: 1.2;
  }

  /* Hovering the title shows the pencil; the Draft badge slides right to make room */
  .pc-title-edit {
    position: absolute;
    left: calc(var(--pc-title-w, 0px) + 12px);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .pc-badge--draft {
    transition: transform 0.25s var(--pc-ease);
  }

  .pc-title-row:hover:not(.is-renaming) .pc-title-edit,
  .pc-title:focus-visible ~ .pc-title-edit {
    opacity: 1;
    pointer-events: auto;
  }

  .pc-title-row:hover:not(.is-renaming) .pc-badge--draft,
  .pc-title:focus-visible ~ .pc-badge--draft {
    transform: translateX(32px);
  }

  .pc-access {
    color: var(--pc-fg-secondary);
    line-height: 1.6;
    text-decoration: underline;
  }

  .pc-editor-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pc-editor-cols {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 0;
  }

  /* Library */
  .pc-library {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .pc-library-head {
    padding: 32px 24px 16px 32px;
  }

  .pc-field-label,
  .pc-field-label-static {
    display: flex;
    flex-direction: column;
    padding-bottom: 4px;
  }

  .pc-field-label strong,
  .pc-field-label-static strong {
    line-height: 1.6;
  }

  .pc-field-label span {
    color: var(--pc-fg-tertiary);
    font-size: 12px;
    line-height: 1.6;
  }

  /* The search field and Add button share one height (34px in the Figma) */
  .pc-library-search-row {
    --pc-control-h: 34px;

    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pc-input--search,
  .pc-library-search-row .pc-btn {
    box-sizing: border-box;
    height: var(--pc-control-h);
    padding-top: 0;
    padding-bottom: 0;
  }

  .pc-input--search {
    flex: 1;
  }

  .pc-library-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 24px 32px 32px;
    overflow-y: auto;
  }

  .pc-topic-card {
    display: flex;
    align-items: center;
    padding: 4px 0;
    border: 1px solid var(--pc-border-subtle);
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    touch-action: pan-y;
    user-select: none;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .pc-topic-card:hover {
    background: #f6f6f6;
  }

  .pc-topic-card-plus {
    flex: none;
    padding-left: 8px;
    opacity: 0.4;
    transition: opacity 0.15s ease;
  }

  .pc-topic-card:hover .pc-topic-card-plus,
  .pc-topic-card:focus-visible .pc-topic-card-plus {
    opacity: 1;
  }

  .pc-topic-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 4px 12px 8px;
  }

  .pc-topic-card-body strong {
    padding-top: 4px;
    line-height: 1.4;
  }

  .pc-topic-card-body small {
    margin-bottom: 4px;
    color: var(--pc-fg-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .pc-topic-card-body span {
    padding: 2px 0;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .pc-topic-card.is-lifted {
    opacity: 0.35;
  }

  .pc-library-empty {
    margin: 0;
    padding: 24px;
    border: 1px dashed var(--pc-border);
    border-radius: 12px;
    color: var(--pc-fg-tertiary);
    line-height: 1.5;
    text-align: center;
  }

  /* Preview */
  .pc-preview-wrap {
    display: flex;
    min-height: 0;
    padding: 24px 24px 24px 16px;
  }

  .pc-preview {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 1px;
    border: 1px solid var(--pc-border-subtle);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--pc-shadow-card);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .pc-preview.is-drop-target {
    border-color: var(--pc-purple);
    box-shadow: var(--pc-shadow-card), 0 0 0 3px rgba(124, 82, 255, 0.15);
  }

  .pc-preview-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid var(--pc-border-subtle);
    border-radius: 15px 15px 0 0;
    background: var(--pc-surface-info);
    line-height: 1.4;
  }

  .pc-preview-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--pc-fg-tertiary);
    font-size: 12px;
  }

  #pc-remaining.is-full {
    color: var(--pc-critical);
  }

  #pc-remaining.is-shake {
    animation: pc-shake 0.4s ease;
  }

  @keyframes pc-shake {
    25% {
      transform: translateX(-3px);
    }
    50% {
      transform: translateX(3px);
    }
    75% {
      transform: translateX(-2px);
    }
  }

  .pc-preview-scroll {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .pc-preview-list {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
  }

  .pc-preview-list:empty {
    padding: 0;
  }

  .pc-preview-empty {
    margin: 0;
    padding: 32px 40px;
    font-size: 19px;
    line-height: 1.6;
  }

  .pc-item {
    display: flex;
    gap: 4px;
    padding: 10px 8px 10px 4px;
    background: #fff;
    transition: background-color 0.15s ease;
  }

  .pc-item:hover {
    background: #f9f9f9;
  }

  .pc-item.is-new {
    animation: pc-added 1.4s ease-out;
  }

  @keyframes pc-added {
    0%,
    25% {
      background-color: rgba(124, 82, 255, 0.12);
    }
  }

  .pc-item-grip,
  .pc-q-grip {
    flex: none;
    display: grid;
    place-items: center;
    align-self: flex-start;
    width: 22px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    cursor: grab !important;
    touch-action: none;
  }

  /* The grip, edit and delete icons show only while the item is hovered or
     has focus (and on the copy being dragged) */
  .pc-item-grip,
  .pc-item-actions {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .pc-item:hover .pc-item-grip,
  .pc-item:hover .pc-item-actions,
  .pc-item:focus-within .pc-item-grip,
  .pc-item:focus-within .pc-item-actions,
  .pc-ghost .pc-item-grip,
  .pc-ghost .pc-item-actions {
    opacity: 1;
  }

  .pc-item-grip:hover,
  .pc-q-grip:hover {
    background: rgba(34, 34, 34, 0.08);
  }

  .pc-item-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .pc-item-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .pc-item-text {
    display: flex;
    flex-direction: column;
  }

  .pc-item-text strong {
    line-height: 1.6;
  }

  .pc-item-text small {
    color: var(--pc-fg-tertiary);
    font-size: 12px;
    line-height: 1.4;
  }

  .pc-item-actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 24px;
  }

  .pc-item-questions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 24px;
  }

  .pc-item-questions-label {
    font-size: 12px;
    font-weight: 590;
    line-height: 1.4;
  }

  .pc-item-questions p {
    margin: 0;
    line-height: 1.2;
  }

  .pc-item.is-slot,
  .pc-question.is-slot,
  .pc-slot {
    position: relative;
    border-radius: 12px;
    background: rgba(124, 82, 255, 0.06);
    box-shadow: inset 0 0 0 1.5px rgba(124, 82, 255, 0.45);
  }

  .pc-item.is-slot > *,
  .pc-question.is-slot > * {
    visibility: hidden;
  }

  .pc-slot {
    flex: none;
    margin: 6px 12px;
  }

  /* Dragged copy */
  .pc-ghost {
    position: fixed !important;
    z-index: 200;
    margin: 0 !important;
    pointer-events: none;
    background: #fff !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.08) !important;
    border-radius: 12px;
    opacity: 0.97;
    will-change: transform;
  }

  .pc-ghost.pc-question {
    padding: 4px 0;
  }

  /* Modals */
  .pc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow-y: auto;
    background: rgba(0, 0, 0, 0.6);
  }

  .pc-backdrop--light {
    background: rgba(0, 0, 0, 0.12);
  }

  .pc-backdrop.is-open {
    animation: pc-fade 0.2s ease;
  }

  .pc-backdrop.is-open .pc-modal {
    animation: pc-rise 0.25s var(--pc-ease);
  }

  @keyframes pc-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes pc-rise {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  .pc-modal {
    position: relative;
    border: 1px solid var(--pc-border-subtle);
    border-radius: 8px;
    background: #fff;
  }

  .pc-modal h2 {
    margin: 0;
  }

  .pc-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .pc-modal--wizard {
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* 848px of content, as drawn */
    width: min(914px, 100%);
    max-height: 100%;
    padding: 24px 32px;
    box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
  }

  .pc-wizard-title {
    position: relative;
  }

  .pc-wizard-title h2 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.6;
  }

  .pc-wizard-close {
    position: absolute;
    top: 0;
    right: 0;
  }

  /* Room for focus rings (2px outline at a 2px offset), which the scroll
     container would otherwise clip */
  .pc-wizard-main {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-height: 0;
    margin: -4px;
    padding: 4px;
    overflow-y: auto;
  }

  .pc-wizard-name {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 416px;
    max-width: 100%;
  }

  .pc-wizard-name strong {
    line-height: 1.4;
  }

  .pc-wizard-name input {
    padding: 10px 16px;
    border: 1.5px solid var(--pc-border-subtle);
    border-radius: 12px;
    outline: none;
    background: var(--pc-input-bg);
    font-size: 19px !important;
    line-height: 1.2;
  }

  .pc-wizard-name input::placeholder {
    color: var(--pc-placeholder);
  }

  .pc-wizard-name input:focus {
    border-color: var(--pc-purple);
  }

  .pc-templates {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pc-templates legend {
    margin-bottom: 8px;
    padding: 0;
    font-weight: 700;
    line-height: 1.4;
  }

  .pc-template-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pc-template-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--pc-border);
    border-radius: 16px;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .pc-template-card:hover {
    border-color: rgba(124, 82, 255, 0.5);
  }

  .pc-template-card:has(input:checked) {
