---
import Layout from '../../layouts/Layout.astro';
import { isAuthed } from '../../lib/showcase-auth';

export const prerender = false;

if (!isAuthed(Astro.cookies)) {
  return Astro.redirect('/showcase');
}

const tiles = ['Participant 1', 'Participant 2', 'Participant 3', 'Participant 4'];
const navRows = [72, 56, 64, 48, 60, 52, 68];
const messages = [
  { name: 92, lines: [88, 62] },
  { name: 64, lines: [74] },
  { name: 80, lines: [92, 80, 44] },
  { name: 72, lines: [58] },
];
const tabs = [
  {
    type: 'chat',
    label: 'Chat',
    zero: { title: 'No messages yet', body: 'Messages from this call will show up here.', icon: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l.9-5.4A8 8 0 1 1 21 12z' },
  },
  { type: 'playbook', label: 'Playbooks' },
  {
    type: 'rta',
    label: 'RTA',
    zero: { title: 'No coaching yet', body: 'Live Coach tips will show up here during the call.', icon: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z' },
  },
];
---

<Layout>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="nd-stage" id="nd-stage" tabindex="-1">
    <div class="nd-frame">
      <div class="nd-bar">
        <div class="nd-toggle" role="group" aria-label="Surface">
          <button type="button" class="nd-toggle-btn is-active" data-surface="meetings" aria-pressed="true">Meetings</button>
          <button type="button" class="nd-toggle-btn" data-surface="app" aria-pressed="false">App</button>
        </div>
        <p class="nd-hints">
          <span><kbd>Shift</kbd><kbd>1</kbd> RTA</span>
          <span><kbd>Shift</kbd><kbd>2</kbd> Chat</span>
          <span><kbd>Shift</kbd><kbd>3</kbd> Playbook</span>
          <span><kbd>Shift</kbd><kbd>Q</kbd><kbd>W</kbd><kbd>E</kbd><kbd>R</kbd> Complete item</span>
          <span><kbd>Esc</kbd> Close panel</span>
        </p>
      </div>

      <div class="nd-surfaces">
        <section class="nd-surface nd-meetings is-active" data-surface-view="meetings" aria-label="Meetings surface wireframe">
          <div class="nd-tiles">
            {tiles.map((name) => (
              <div class="nd-tile">
                <span class="nd-tile-avatar"></span>
                <span class="nd-tile-name">{name}</span>
              </div>
            ))}
          </div>
          <div class="nd-controls">
            <div class="nd-control-group"><span class="nd-control-pill"></span></div>
            <div class="nd-control-group">
              <span class="nd-control"></span>
              <span class="nd-control"></span>
              <span class="nd-control"></span>
              <span class="nd-control nd-control--end"></span>
            </div>
            <div class="nd-control-group">
              <span class="nd-control"></span>
              <span class="nd-control"></span>
            </div>
          </div>
        </section>

        <section class="nd-surface nd-app" data-surface-view="app" aria-label="App surface wireframe">
          <div class="nd-topbar">
            <span class="nd-sk nd-sk--logo"></span>
            <span class="nd-sk nd-sk--search"></span>
            <span class="nd-sk nd-sk--circle"></span>
          </div>
          <div class="nd-app-body">
            <div class="nd-leftbar">
              {navRows.map((width) => (
                <div class="nd-nav-row">
                  <span class="nd-sk nd-sk--dot"></span>
                  <span class="nd-sk" style={`width:${width}%`}></span>
                </div>
              ))}
            </div>
            <div class="nd-conversation">
              <div class="nd-conversation-head">
                <span class="nd-sk nd-sk--circle"></span>
                <span class="nd-sk" style="width:160px"></span>
              </div>
              <div class="nd-messages">
                {messages.map((message) => (
                  <div class="nd-message">
                    <span class="nd-sk nd-sk--circle"></span>
                    <div class="nd-message-lines">
                      <span class="nd-sk nd-sk--strong" style={`width:${message.name}px`}></span>
                      {message.lines.map((width) => (
                        <span class="nd-sk" style={`width:${width}%`}></span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              <div class="nd-composer"></div>
            </div>
          </div>
        </section>
      </div>

      <div class="nd-stacks" aria-live="polite">
        <div class="nd-stack" data-stack="rta"></div>
        <div class="nd-stack" data-stack="chat"></div>
        <div class="nd-stack" data-stack="playbook"></div>
      </div>
    </div>

    <aside class="nd-panel" id="nd-panel" tabindex="-1" aria-label="Current call" aria-hidden="true">
      <div class="nd-panel-container">
        <div class="nd-panel-header">
          <div class="nd-tabs" role="tablist" aria-label="Call details">
            {tabs.map((tab, index) => (
              <button
                type="button"
                class:list={['nd-tab', { 'is-active': index === 0 }]}
                role="tab"
                id={`nd-tab-${tab.type}`}
                data-tab={tab.type}
                aria-controls={`nd-tabpanel-${tab.type}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
              >
                {tab.label}
                <span class="nd-tab-count" hidden></span>
              </button>
            ))}
          </div>
          <button type="button" class="nd-icon-btn" id="nd-panel-close" aria-label="Close panel">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
        <div class="nd-panel-content">
          {tabs.map((tab, index) => (
            <div
              class:list={['nd-tabpanel', `nd-tabpanel--${tab.type}`, { 'is-offstage': tab.type === 'playbook' }]}
              role="tabpanel"
              id={`nd-tabpanel-${tab.type}`}
              data-tabpanel={tab.type}
              aria-labelledby={`nd-tab-${tab.type}`}
              hidden={index !== 0 && tab.type !== 'playbook'}
            >
              {tab.type === 'playbook' ? (
                <>
                  <div class="nd-pb-header">
                    <span>BANT</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5" /></svg>
                  </div>
                  <div class="nd-pb-list" id="nd-pb-list"></div>
                </>
              ) : (
                <>
                  <div class="nd-rows" data-rows={tab.type}></div>
                  <div class="nd-zero">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={tab.zero?.icon} /></svg>
                    <p class="nd-zero-title">{tab.zero?.title}</p>
                    <p class="nd-zero-body">{tab.zero?.body}</p>
                  </div>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Layout>

<script>
  type NotificationType = 'rta' | 'chat' | 'playbook';

  type Card = {
    type: NotificationType;
    el: HTMLElement;
    height: number;
    remaining: number;
    startedAt: number;
    timer: number | undefined;
    observer: ResizeObserver;
  };

  type Stack = {
    el: HTMLElement;
    cards: Card[];
    isHovering: boolean;
    hoverTimer: number | undefined;
  };

  type PlaybookItem = {
    title: string;
    description: string;
    prompts: string[];
    summary: string[];
    // pending: triggered, but held until the Playbooks tab is on screen
    state: 'open' | 'pending' | 'complete';
    detected: boolean;
    descriptionOpen: boolean;
    timers: Set<number>;
    card: HTMLElement;
    checkbox: HTMLInputElement;
    collapsible: HTMLElement;
    toggle: HTMLButtonElement;
    summarySection: HTMLElement;
    chunks: HTMLElement;
  };

  const NOTIFICATION_TIMEOUT = 8000;
  const HOVER_IN_DELAY = 500;
  const HOVER_OUT_DELAY = 500;
  const LEAVE_DURATION = 300;
  const STACK_GAP = 4;
  const PANEL_SLIDE = 450;
  const TAB_FADE = 150;
  const SEQUENCE_STAGGER = 250;
  const WORD_INTERVAL = 80;

  const SHORTCUTS: Record<string, 'rta' | 'chat'> = {
    Digit1: 'rta',
    Digit2: 'chat',
  };

  const ITEM_SHORTCUTS: Record<string, number> = {
    KeyQ: 0,
    KeyW: 1,
    KeyE: 2,
    KeyR: 3,
  };

  // Copy is from the Playbook prototype, except the Authority and Need summaries and all of Timing
  const PLAYBOOK_COPY = [
    {
      title: 'Budget',
      description: 'Find the allocated budget for this project or solution',
      prompts: ['What is your allocated budget for this project or solution?', 'Have you considered any financial restraints?'],
      summary: [
        'The agent asked about budget that has been allocated to this effort.',
        'The customer says the budget is flexible depending on the proposed solution.',
        'The agent asks about factors driving the budget',
        'The customer mentions high energy costs and inefficiencies impacting their operational costs and brand reputation, highlighting an urgency to adapt before the new environmental regulations take effect.',
      ],
    },
    {
      title: 'Authority',
      description: 'Discover key decision-makers involved in the purchase?',
      prompts: ['When was the last time you bought a similar product?', 'How did the decision making process go?'],
      summary: ['The customer says the VP of Operations makes the final decision, with input from IT and finance, as they did on their last similar purchase.'],
    },
    {
      title: 'Need',
      description: 'Uncover the main challenges or pain points the customer is facing right now',
      prompts: ['What happens to your team’s goals if you don’t address this need?', 'How many licenses do you anticipate to meet your team’s needs?'],
      summary: [
        'The agent asked what happens to the team’s goals if this need goes unaddressed.',
        'The customer says they would likely miss their energy reduction targets and fall short of the new environmental regulations.',
        'The agent asks how many licenses the team would need.',
        'The customer estimates 40 licenses for the operations team, with room to add more if the initial rollout reduces inefficiencies across their other sites.',
      ],
    },
    {
      title: 'Timing',
      description: 'Establish when the customer plans to have a solution in place and what is driving that date',
      prompts: ['When are you hoping to have a solution in place?', 'Are there any upcoming events or milestones that could influence when you get started?'],
      summary: [
        'The agent asked when the team hopes to have a solution in place.',
        'The customer says they want to be live before the new environmental regulations take effect at the start of Q3.',
        'The agent asks whether any other milestones could influence the start date.',
        'The customer says their current vendor contract ends in May, so they plan to make a decision within the next 60 days to leave time for rollout.',
      ],
    },
  ];

  const TITLES: Record<NotificationType, string> = {
    rta: 'Live Coach',
    chat: 'Chat',
    playbook: 'Playbook',
  };

  const ICONS: Record<NotificationType, string> = {
    rta: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
    chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l.9-5.4A8 8 0 1 1 21 12z"/>',
    playbook: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM9 11h6M9 15h6"/>',
  };

  const CHECK_ICON = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17 19 7"/></svg>';
  const CLOSE_ICON = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';

  const RTA_LINES = [
    'Customer mentioned a competitor. Ask what they like about it.',
    "You've been talking for two minutes. Try an open question.",
    'They asked about pricing. Confirm team size before quoting.',
    'Sentiment dropped after the timeline. Acknowledge the concern.',
  ];
  const CHAT_LINES = [
    { name: 'Priya', message: 'Can you share the deck after this?' },
    { name: 'Jordan', message: 'Pulling up the renewal numbers now.' },
    { name: 'Sam', message: 'Their legal team needs the security doc.' },
    { name: 'Alex', message: 'Here are the screens we talked about.' },
  ];
  const SPARKLE_PATH = 'M9 1a.5.5 0 0 1 .5.5V2h.5a.5.5 0 0 1 0 1h-.5v.5a.5.5 0 0 1-1 0V3H8a.5.5 0 0 1 0-1h.5v-.5A.5.5 0 0 1 9 1ZM5 2a.5.5 0 0 1 .455.293L6.471 4.53l2.236 1.016a.5.5 0 0 1 0 .91L6.47 7.471 5.455 9.707a.5.5 0 0 1-.91 0L3.529 7.47 1.293 6.455a.5.5 0 0 1 0-.91L3.53 4.529l1.016-2.236A.5.5 0 0 1 5 2Zm0 1.708-.639 1.405a.5.5 0 0 1-.248.248L2.708 6l1.405.639a.5.5 0 0 1 .248.248L5 8.292l.639-1.405a.5.5 0 0 1 .248-.248L7.292 6l-1.405-.639a.5.5 0 0 1-.248-.248L5 3.708ZM9.5 8a.5.5 0 0 1 .5.5V9h.5a.5.5 0 0 1 0 1H10v.5a.5.5 0 0 1-1 0V10h-.5a.5.5 0 0 1 0-1H9v-.5a.5.5 0 0 1 .5-.5Z';

  const pick = <T,>(items: T[]): T => items[Math.floor(Math.random() * items.length)];

  const make = (tag: string, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  function renderContent(type: NotificationType, topicTitle = '') {
    const content = make('div', 'nd-card-content');
    if (type === 'rta') {
      content.append(make('p', 'nd-card-headline', pick(RTA_LINES)));
    } else if (type === 'chat') {
      const line = pick(CHAT_LINES);
      const message = make('p', 'nd-card-body', line.message);
      content.append(make('p', 'nd-card-headline', line.name), message);
      if (Math.random() < 0.5) {
        message.append(' ', make('span', 'nd-card-link', 'dialpad.com/share'));
      } else {
        const thumbs = make('div', 'nd-card-thumbs');
        const count = 1 + Math.floor(Math.random() * 4);
        for (let i = 0; i < count; i += 1) thumbs.append(make('span', 'nd-card-thumb'));
        content.append(thumbs);
      }
    } else {
      const topic = make('div', 'nd-card-topic');
      const checkbox = make('span', 'nd-card-checkbox');
      checkbox.innerHTML = CHECK_ICON;
      topic.append(checkbox, make('p', 'nd-card-topic-text', topicTitle));
      content.append(topic, make('p', 'nd-card-note', 'Item completed'));
    }
    return content;
  }

  function buildPlaybookItem(copy: (typeof PLAYBOOK_COPY)[number], index: number): PlaybookItem {
    const inputId = `nd-pb-check-${index}`;

    const card = make('div', 'nd-pb-card');
    card.dataset.checkedByAi = 'false';

    const checkbox = make('input', 'nd-pb-checkbox') as HTMLInputElement;
    checkbox.type = 'checkbox';
    checkbox.id = inputId;
    checkbox.setAttribute('aria-label', `Complete ${copy.title} task`);

    const titleRow = make('div', 'nd-pb-title-row');
    const label = make('label', 'nd-pb-title', copy.title) as HTMLLabelElement;
    label.htmlFor = inputId;
    const sparkle = make('span', 'nd-pb-sparkle');
    sparkle.innerHTML = `<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><defs><linearGradient id="nd-pb-sparkle-${index}" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fc5ea0"/><stop offset="100%" stop-color="#7c52ff"/></linearGradient></defs><path fill="url(#nd-pb-sparkle-${index})" fill-rule="evenodd" clip-rule="evenodd" d="${SPARKLE_PATH}"/></svg>`;
    titleRow.append(label, sparkle);

    const collapsible = make('div', 'nd-pb-collapsible');
    collapsible.dataset.open = 'true';
    const collapsibleInner = make('div');
    const prompts = make('div', 'nd-pb-prompts');
    copy.prompts.forEach((prompt) => prompts.append(make('p', 'nd-pb-compact', prompt)));
    collapsibleInner.append(make('p', 'nd-pb-compact', copy.description), make('h6', 'nd-pb-heading nd-pb-heading--questions', 'Questions'), prompts);
    collapsible.append(collapsibleInner);

    const toggle = make('button', 'nd-pb-toggle') as HTMLButtonElement;
    toggle.type = 'button';
    toggle.hidden = true;

    const details = make('div', 'nd-pb-details');
    details.append(titleRow, collapsible, toggle);

    const summarySection = make('div', 'nd-pb-summary');
    summarySection.hidden = true;
    const chunks = make('div', 'nd-pb-chunks');
    summarySection.append(make('h4', 'nd-pb-heading', 'Summary:'), chunks);

    const body = make('div', 'nd-pb-body');
    body.append(details, summarySection);
    card.append(checkbox, body);

    return {
      ...copy,
      state: 'open',
      detected: false,
      descriptionOpen: true,
      timers: new Set(),
      card,
      checkbox,
      collapsible,
      toggle,
      summarySection,
      chunks,
    };
  }

  function init() {
    const stage = document.getElementById('nd-stage');
    const panel = document.getElementById('nd-panel');
    const closeButton = document.getElementById('nd-panel-close');
    const playbookList = document.getElementById('nd-pb-list');
    if (!stage || !panel || !closeButton || !playbookList) return undefined;

    const tabButtons = [...stage.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const toggleButtons = [...stage.querySelectorAll<HTMLButtonElement>('[data-surface]')];
    const surfaces = [...stage.querySelectorAll<HTMLElement>('[data-surface-view]')];
    const unread: Record<NotificationType, number> = { rta: 0, chat: 0, playbook: 0 };
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const items = PLAYBOOK_COPY.map(buildPlaybookItem);
    const collapsibleObserver = new ResizeObserver((entries) => {
      entries.forEach((entry) => {
        const card = entry.target.closest<HTMLElement>('.nd-pb-card')!;
        card.style.setProperty('--collapsible-height', `${(entry.target as HTMLElement).offsetHeight}px`);
      });
    });

    const makeStack = (type: NotificationType): Stack => ({
      el: stage.querySelector<HTMLElement>(`[data-stack="${type}"]`)!,
      cards: [],
      isHovering: false,
      hoverTimer: undefined,
    });
    const stacks: Record<NotificationType, Stack> = { rta: makeStack('rta'), chat: makeStack('chat'), playbook: makeStack('playbook') };
    const stackList = Object.values(stacks);
    const allCards = () => stackList.flatMap((stack) => stack.cards);
    const anyHovering = () => stackList.some((stack) => stack.isHovering);

    let isOpen = false;
    let activeTab: NotificationType = 'chat';
    const pendingRemovals = new Set<number>();

    function layout(stack: Stack) {
      const { cards } = stack;
      let y = 0;
      let total = 0;
      cards.forEach((card, index) => {
        card.el.style.setProperty('--y', `${y}px`);
        card.el.style.setProperty('--index', String(index));
        card.el.style.setProperty('--height', `${card.height}px`);
        card.el.style.zIndex = String(Math.max(0, 3 - index));
        card.el.classList.toggle('is-front', index === 0);
        card.el.classList.toggle('is-buried', index > 2);
        y += card.height;
        total += card.height;
      });
      stack.el.classList.toggle('has-cards', cards.length > 0);
      stack.el.style.setProperty('--stack-height', `${cards[0]?.height ?? 0}px`);
      stack.el.style.setProperty('--notification-count', String(cards.length));
      stack.el.style.setProperty('--unfurled-stack-height', `${total + STACK_GAP * Math.max(0, cards.length - 1)}px`);
    }

    function startTimer(card: Card) {
      card.startedAt = Date.now();
      card.timer = window.setTimeout(() => removeCard(card), card.remaining);
    }

    function pauseTimers() {
      allCards().forEach((card) => {
        if (card.timer === undefined) return;
        window.clearTimeout(card.timer);
        card.timer = undefined;
        card.remaining -= Date.now() - card.startedAt;
      });
    }

    function resumeTimers() {
      allCards().forEach((card) => {
        if (card.timer === undefined) startTimer(card);
      });
    }

    function setUnfurled(stack: Stack, value: boolean) {
      stack.el.classList.toggle('is-unfurled', value);
    }

    // Hovering any stack holds every card, as in the prototype, but only unfurls that stack
    function enterStack(stack: Stack) {
      if (stack.isHovering) return;
      window.clearTimeout(stack.hoverTimer);
      if (!anyHovering()) pauseTimers();
      stack.isHovering = true;
      stack.hoverTimer = window.setTimeout(() => setUnfurled(stack, true), HOVER_IN_DELAY);
    }

    function leaveStack(stack: Stack) {
      if (!stack.isHovering) return;
      window.clearTimeout(stack.hoverTimer);
      stack.isHovering = false;
      if (!anyHovering()) resumeTimers();
      stack.hoverTimer = window.setTimeout(() => setUnfurled(stack, false), HOVER_OUT_DELAY);
    }

    function removeCard(card: Card) {
      const stack = stacks[card.type];
      if (!stack.cards.includes(card)) return;
      window.clearTimeout(card.timer);
      card.observer.disconnect();
      stack.cards = stack.cards.filter((item) => item !== card);
      card.el.classList.add('is-leaving');
      const removal = window.setTimeout(() => {
        card.el.remove();
        pendingRemovals.delete(removal);
      }, LEAVE_DURATION);
      pendingRemovals.add(removal);
      layout(stack);
      // The cursor never fires mouseleave on a stack that has emptied under it
      if (stack.cards.length === 0) {
        leaveStack(stack);
        setUnfurled(stack, false);
      }
    }

    function revealInPanel(element: HTMLElement) {
      // Not scrollIntoView: it would also scroll the stage while the panel is off-screen
      const content = panel!.querySelector<HTMLElement>('.nd-panel-content')!;
      const offset = element.getBoundingClientRect().top - content.getBoundingClientRect().top;
      if (offset < 0 || offset > content.clientHeight - element.offsetHeight) content.scrollTop += offset;
    }

    function highlight(row: HTMLElement) {
      row.classList.remove('is-highlighted');
      void row.offsetWidth;
      row.classList.add('is-highlighted');
      revealInPanel(row);
    }

    function renderUnread() {
      tabButtons.forEach((button) => {
        const count = unread[button.dataset.tab as NotificationType];
        const badge = button.querySelector<HTMLElement>('.nd-tab-count')!;
        badge.textContent = String(count);
        badge.hidden = count === 0;
      });
    }

    function selectTab(type: NotificationType, settleDelay = TAB_FADE, first?: PlaybookItem) {
      const changed = type !== activeTab;
      activeTab = type;
      tabButtons.forEach((button) => {
        const selected = button.dataset.tab === type;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      stage!.querySelectorAll<HTMLElement>('[data-tabpanel]').forEach((tabpanel) => {
        const selectedPanel = tabpanel.dataset.tabpanel === type;
        if (tabpanel.dataset.tabpanel === 'playbook') tabpanel.classList.toggle('is-offstage', !selectedPanel);
        else tabpanel.hidden = !selectedPanel;
        if (selectedPanel && changed && !reducedMotion.matches) {
          tabpanel.animate([{ opacity: 0 }, { opacity: 1 }], { duration: TAB_FADE, easing: 'ease' });
        }
      });
      if (changed) panel!.querySelector('.nd-panel-content')!.scrollTop = 0;
      unread[type] = 0;
      renderUnread();
      // Those rows are on screen now, so their cards would only repeat them
      stacks[type].cards.forEach(removeCard);
      if (type === 'playbook') runPending(settleDelay, first);
    }

    function openPanel(type: NotificationType, first?: PlaybookItem) {
      const wasClosed = !isOpen;
      if (wasClosed) {
        isOpen = true;
        stage!.classList.add('is-open');
        panel!.setAttribute('aria-hidden', 'false');
        // The stacks move out from under a stationary cursor
        stackList.forEach(leaveStack);
      }
      selectTab(type, wasClosed ? PANEL_SLIDE : TAB_FADE, first);
      panel!.focus({ preventScroll: true });
    }

    function closePanel() {
      if (!isOpen) return;
      isOpen = false;
      stage!.classList.remove('is-open');
      panel!.setAttribute('aria-hidden', 'true');
      stackList.forEach(leaveStack);
      // The card that opened the panel has already left, so focus the next one
      const target = allCards()[0]?.el.querySelector<HTMLElement>('.nd-card-open') ?? stage!;
      target.focus({ preventScroll: true });
    }

    function addRow(type: NotificationType, content: HTMLElement, timestamp: string) {
      const row = make('div', 'nd-row');
      const time = make('p', 'nd-row-time', timestamp);
      row.append(content, time);
      stage!.querySelector(`[data-rows="${type}"]`)!.prepend(row);
      return row;
    }

    function fire(type: 'rta' | 'chat') {
      const timestamp = new Date().toLocaleTimeString();
      const content = renderContent(type);
      const row = addRow(type, content.cloneNode(true) as HTMLElement, timestamp);

      if (isOpen && activeTab === type) {
        highlight(row);
        return;
      }

      showCard(type, content, timestamp, () => {
        openPanel(type);
        highlight(row);
      });
    }

    function showCard(type: NotificationType, content: HTMLElement, timestamp: string, onOpen: () => void) {
      unread[type] += 1;
      renderUnread();

      const el = make('div', `nd-card nd-card--${type} is-entering`);
      const open = make('button', 'nd-card-open') as HTMLButtonElement;
      open.type = 'button';
      open.setAttribute('aria-label', `Open ${TITLES[type]} notification`);

      const close = make('button', 'nd-card-close') as HTMLButtonElement;
      close.type = 'button';
      close.setAttribute('aria-label', `Dismiss ${TITLES[type]} notification`);
      close.innerHTML = CLOSE_ICON;

      const header = make('div', 'nd-card-header');
      const icon = make('span', 'nd-card-icon');
      icon.innerHTML = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[type]}</svg>`;
      header.append(icon, make('h4', 'nd-card-title', `${TITLES[type]} · ${timestamp}`));
      el.append(open, close, header, content);

      const stack = stacks[type];
      const card: Card = {
        type,
        el,
        height: 0,
        remaining: NOTIFICATION_TIMEOUT,
        startedAt: 0,
        timer: undefined,
        observer: new ResizeObserver((entries) => {
          card.height = entries[0].borderBoxSize[0].blockSize;
          layout(stack);
        }),
      };

      open.addEventListener('click', onOpen);
      close.addEventListener('click', () => removeCard(card));

      stack.cards.unshift(card);
      stack.el.prepend(el);
      card.observer.observe(el);
      card.height = el.offsetHeight;
      layout(stack);
      void el.offsetWidth;
      el.classList.remove('is-entering');

      if (!anyHovering()) startTimer(card);
    }

    function after(item: PlaybookItem, delay: number, run: () => void) {
      const timer = window.setTimeout(() => {
        item.timers.delete(timer);
        run();
      }, delay);
      item.timers.add(timer);
    }

    function renderDescription(item: PlaybookItem) {
      item.collapsible.dataset.open = String(item.descriptionOpen);
      item.toggle.textContent = `${item.descriptionOpen ? 'Hide' : 'Show'} description and questions`;
      item.toggle.classList.toggle('has-gap', item.descriptionOpen);
    }

    function completeItem(item: PlaybookItem) {
      if (item.state !== 'open') return;
      if (isOpen && activeTab === 'playbook') {
        runSequence(item);
        return;
      }
      item.state = 'pending';
      showCard('playbook', renderContent('playbook', item.title), new Date().toLocaleTimeString(), () => openPanel('playbook', item));
    }

    function runPending(delay: number, first?: PlaybookItem) {
      const pending = items.filter((item) => item.state === 'pending');
      if (first && pending.includes(first)) pending.sort((a, b) => Number(b === first) - Number(a === first));
      const start = reducedMotion.matches ? 0 : delay;
      pending.forEach((item, index) => {
        item.state = 'complete';
        after(item, start + index * SEQUENCE_STAGGER, () => runSequence(item));
      });
    }

    function runSequence(item: PlaybookItem) {
      item.state = 'complete';
      revealInPanel(item.card);
      const check = make('div', 'nd-pb-check');
      check.innerHTML = '<svg class="nd-pb-check-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 10 17 19 7"/></svg>';
      item.card.prepend(check);
      item.card.dataset.checkedByAi = 'true';
    }

    // The check's grow animation ends first, at about 1.34s
    function onDetected(item: PlaybookItem) {
      if (item.detected || item.card.dataset.checkedByAi !== 'true') return;
      item.detected = true;
      item.descriptionOpen = false;
      item.toggle.hidden = false;
      item.summarySection.hidden = false;
      renderDescription(item);
      playChunk(item, 0);
    }

    function playChunk(item: PlaybookItem, index: number) {
      const text = item.summary[index];
      if (text === undefined) return;

      const chunk = make('div', 'nd-pb-chunk');
      const marker = make('div', 'nd-pb-chunk-marker');
      marker.append(make('span', 'nd-pb-chunk-dot'));
      const words = make('div', 'nd-pb-chunk-text');
      chunk.append(marker, words);
      item.chunks.append(chunk);

      const list = text.split(' ');
      list.forEach((word, wordIndex) => {
        const addWord = () => {
          const span = make('span', undefined, `${word} `);
          span.style.animationDelay = `${wordIndex * 0.01}s`;
          words.append(span);
          if (wordIndex === list.length - 1 && !reducedMotion.matches) {
            span.addEventListener('animationend', () => playChunk(item, index + 1));
          }
        };
        if (reducedMotion.matches) addWord();
        else after(item, wordIndex * WORD_INTERVAL, addWord);
      });
      if (reducedMotion.matches) playChunk(item, index + 1);
    }

    function resetItem(item: PlaybookItem) {
      item.timers.forEach((timer) => window.clearTimeout(timer));
      item.timers.clear();
      item.card.querySelector('.nd-pb-check')?.remove();
      item.card.dataset.checkedByAi = 'false';
      item.state = 'open';
      item.detected = false;
      item.descriptionOpen = true;
      item.toggle.hidden = true;
      item.summarySection.hidden = true;
      item.chunks.replaceChildren();
      item.checkbox.checked = false;
      renderDescription(item);
    }

    function setSurface(name: string) {
      surfaces.forEach((surface) => surface.classList.toggle('is-active', surface.dataset.surfaceView === name));
      toggleButtons.forEach((button) => {
        const active = button.dataset.surface === name;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        closePanel();
        return;
      }
      if (!event.shiftKey || event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
      const type = SHORTCUTS[event.code];
      if (type) {
        event.preventDefault();
        fire(type);
        return;
      }
      const item = event.code === 'Digit3' ? items.find((candidate) => candidate.state === 'open') : items[ITEM_SHORTCUTS[event.code]];
      if (event.code === 'Digit3' || item) event.preventDefault();
      if (item) completeItem(item);
    }

    function onTabKeydown(event: KeyboardEvent) {
      const index = tabButtons.indexOf(event.currentTarget as HTMLButtonElement);
      const last = tabButtons.length - 1;
      const targets: Record<string, number> = {
        ArrowRight: index === last ? 0 : index + 1,
        ArrowLeft: index === 0 ? last : index - 1,
        Home: 0,
        End: last,
      };
      const target = targets[event.key];
      if (target === undefined) return;
      event.preventDefault();
      selectTab(tabButtons[target].dataset.tab as NotificationType);
      tabButtons[target].focus({ preventScroll: true });
    }

    const controller = new AbortController();
    const { signal } = controller;

    document.addEventListener('keydown', onKeydown, { signal });
    // A mouse-focused control would show its focus ring on the next demo shortcut
    stage.addEventListener('mousedown', (event) => {
      if ((event.target as HTMLElement).closest('button, input')) event.preventDefault();
    }, { signal });
    closeButton.addEventListener('click', closePanel, { signal });
    stackList.forEach((stack) => {
      const enter = () => enterStack(stack);
      const leave = () => leaveStack(stack);
      stack.el.addEventListener('mouseenter', enter, { signal });
      // Catches a cursor the stack has just moved under, which fires no mouseenter
      stack.el.addEventListener('mousemove', enter, { signal });
      stack.el.addEventListener('mouseleave', leave, { signal });
      stack.el.addEventListener('focusin', enter, { signal });
      stack.el.addEventListener('focusout', leave, { signal });
    });
    tabButtons.forEach((button) => {
      button.addEventListener('click', () => selectTab(button.dataset.tab as NotificationType), { signal });
      button.addEventListener('keydown', onTabKeydown, { signal });
    });
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => setSurface(button.dataset.surface!), { signal });
    });
    items.forEach((item) => {
      playbookList.append(item.card);
      renderDescription(item);
      collapsibleObserver.observe(item.collapsible.firstElementChild!);
      item.card.addEventListener('animationend', () => onDetected(item), { signal });
      item.toggle.addEventListener('click', () => {
        item.descriptionOpen = !item.descriptionOpen;
        renderDescription(item);
      }, { signal });
      item.checkbox.addEventListener('click', () => {
        if (item.state === 'complete') {
          resetItem(item);
          return;
        }
        item.descriptionOpen = !item.checkbox.checked;
        renderDescription(item);
      }, { signal });
    });

    return () => {
      controller.abort();
      stackList.forEach((stack) => window.clearTimeout(stack.hoverTimer));
      pendingRemovals.forEach((removal) => window.clearTimeout(removal));
      collapsibleObserver.disconnect();
      items.forEach((item) => item.timers.forEach((timer) => window.clearTimeout(timer)));
      allCards().forEach((card) => {
        window.clearTimeout(card.timer);
        card.observer.disconnect();
      });
    };
  }

  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup = init();
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

